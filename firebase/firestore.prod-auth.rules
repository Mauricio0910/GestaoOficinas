rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regra-base para a próxima etapa com Firebase Authentication.
    // A versão atual do MVP usa login interno e não usa Firebase Auth ainda.
    match /oficinas/{oficinaId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
